@model Pawsome_Pets.Views.Profile.ProfileViewModel
@using Microsoft.AspNetCore.Identity
@using Pawsome_Pets.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
}

<h2>My Profile</h2>

<form asp-action="Update" method="post">
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Update Profile</button>
</form>

<hr />


<div class="mt-4">
    @if (roles.Contains("Giver"))
    {
        <a asp-controller="Profile" asp-action="RequestsToMyAnimals" class="btn btn-primary">
            View All Requests to My Animals
        </a>
    }
    else if (roles.Contains("Adopter"))
    {
        <a asp-controller="AdoptionRequest" asp-action="MyRequests" class="btn btn-primary">
            View My Adoption Requests
        </a>
    }
    else if (roles.Contains("Caretaker"))
    {
        <a asp-controller="CaretakingRequest" asp-action="MyRequests" class="btn btn-primary">
            View My Caretaking Requests
        </a>
    }
    else if (roles.Contains("Admin"))
    {
        <a asp-action="AdminPanel" asp-controller="Profile" class="btn btn-danger mt-3">Admin Panel</a>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}