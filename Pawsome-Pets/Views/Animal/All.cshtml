@model Pawsome_Pets.Views.Animal.AnimalListViewModel

@{
    ViewData["Title"] = "All Animals";
}

@section Styles {
    <style>
        .animal-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 20px;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: scale(1.02);
            }

        .filter-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

            .filter-container form {
                display: flex;
                align-items: center;
            }

            .filter-container select {
                min-width: 220px;
            }
    </style>
}

<h2 class="mt-3">@ViewData["Title"]</h2>

<div class="filter-container">
    <form asp-action="All" method="get">
        <label for="categoryFilter" class="form-label me-2 mb-0">Filter by Category:</label>
        <select id="categoryFilter" name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.SelectedCategoryId)">
                    @category.Name
                </option>
            }
        </select>
    </form>

    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Giver")))
    {
        <a asp-controller="Animal" asp-action="Add" class="btn btn-success">Add a Friend</a>
    }
</div>

@if (!Model.Animals.Any())
{
    <div class="alert alert-info">No animals available.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @foreach (var animal in Model.Animals.Take(9))
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@animal.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm text-center p-2">
                        <img src="@animal.ImageUrl" class="animal-image card-img-top" alt="@animal.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@animal.Name</h5>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}