@model Pawsome_Pets.Views.Animal.AnimalListViewModel

@{
    ViewData["Title"] = "All Animals";
}

@section Styles {
    <style>
        .animal-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 20px;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: scale(1.02);
            }

        .filter-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

            .filter-container form {
                display: flex;
                align-items: center;
            }

            .filter-container select {
                min-width: 220px;
            }

        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-radius: 50%;
            color: white;
            font-weight: bold;
        }
    </style>
}

<h2 class="mt-3">@ViewData["Title"]</h2>

<div class="filter-container">
    <form asp-action="All" method="get">
        <label for="categoryFilter" class="form-label me-2 mb-0">Filter by Category:</label>
        <select id="categoryFilter" name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.SelectedCategoryId)">
                    @category.Name
                </option>
            }
        </select>
    </form>

    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Giver")))
    {
        <a asp-controller="Animal" asp-action="Add" class="btn btn-success">Add a Friend</a>
    }
</div>

@if (!Model.Animals.Any())
{
    <div class="alert alert-info">No animals available.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @foreach (var animal in Model.Animals.Take(9))
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@animal.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm text-center p-2">
                        <img src="@animal.ImageUrl" class="animal-image card-img-top" alt="@animal.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@animal.Name</h5>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-center">
            <ul class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="All" asp-route-page="@(Model.CurrentPage - 1)" asp-route-categoryId="@Model.SelectedCategoryId">&lt;</a>
                    </li>
                }

                @{
                    int start = Math.Max(1, Model.CurrentPage - 1);
                    int end = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

                    if (Model.CurrentPage == 1)
                    {
                        end = Math.Min(Model.TotalPages, 2);
                    }
                    else if (Model.CurrentPage == Model.TotalPages)
                    {
                        start = Math.Max(1, Model.TotalPages - 1);
                    }
                }

                @for (int i = start; i <= end; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="All" asp-route-page="@i" asp-route-categoryId="@Model.SelectedCategoryId">@i</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="All" asp-route-page="@(Model.CurrentPage + 1)" asp-route-categoryId="@Model.SelectedCategoryId">&gt;</a>
                    </li>
                }
            </ul>
        </nav>
    }
}