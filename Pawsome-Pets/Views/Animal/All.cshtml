@model Pawsome_Pets.Views.Animal.AnimalListViewModel

@{
    ViewData["Title"] = "All Animals";
}
@section Styles {
    <style>
        .card-img-top {
            height: 200px; 
            object-fit: cover;
            border-radius: 15px; 
        }

        .card-footer .btn {
            min-width: 90px; 
        }
    </style>
}

<h2 class="mt-3">@ViewData["Title"]</h2>

<div class="d-flex justify-content-between align-items-center mb-4">
    <form asp-action="All" method="get" class="d-flex align-items-center">
        <label for="categoryFilter" class="form-label me-2 mb-0">Filter by Category:</label>
        <select id="categoryFilter" name="categoryId" class="form-select" onchange="this.form.submit()" style="min-width: 220px;">
            <option value="">All Categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.SelectedCategoryId)">
                    @category.Name
                </option>
            }
        </select>
    </form>

    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Giver")))
    {
        <a asp-controller="Animal" asp-action="Add" class="btn btn-success ms-3">Add a Friend</a>
    }
</div>

@if (!Model.Animals.Any())
{
    <div class="alert alert-info">No animals available.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var animal in Model.Animals.Take(9))
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@animal.ImageUrl" class="card-img-top" alt="@animal.Name" style="height: 250px; object-fit: cover;" />
                    <div class="card-body text-center">
                        <h5 class="card-title">@animal.Name</h5>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@animal.Id" class="btn btn-outline-primary btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@animal.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@animal.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}